# Reference only. Copy the service-specific .env.example beside each service.

# Supabase Postgres
DATABASE_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=

# Web -> video worker
VIDEO_WORKER_URL=
VIDEO_WORKER_SECRET=

# Browser protection (HTTP Basic; required in production)
CARDVAULT_WEB_USERNAME=
CARDVAULT_WEB_PASSWORD=

# MCP -> web app (server-to-server)
APP_INTERNAL_BASE_URL=
MCP_INTERNAL_TOKEN=

# MCP OAuth (required for ChatGPT Developer Mode)
MCP_PUBLIC_URL=
MCP_AUTH_MODE=
MCP_OAUTH_PASSWORD=
MCP_OAUTH_SECRET=

# Public web URL
NEXT_PUBLIC_APP_URL=
